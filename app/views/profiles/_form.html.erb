<div class="min-h-screen bg-gray-100 flex items-center justify-center py-10 px-4">
  <div class="w-full max-w-xl bg-white rounded-2xl shadow-lg p-6 sm:p-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-semibold mb-6 text-center">
        <%= @profile.new_record? ? "Create Profile" : "Update Profile" %>
      </h1>
      <p class="mt-2 text-sm text-gray-500">
        <%= @profile.new_record? ? "Fill in the details to create your profile" : "Update the details of your profile" %>
      </p>
    </div>

    <%= form_with model: [current_user, @profile], class: "space-y-5" do |f| %>

      <div>
        <%= f.label :avatar, class: "block font-medium mb-1" %>
        <%= f.file_field :avatar, class: "w-full" %>
      </div>

      <div>
        <%= f.label :first_name, "First Name *", class: "block font-medium mb-1" %>
        <%= f.text_field :first_name, class: "w-full border rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :last_name, "Last Name *", class: "block font-medium mb-1" %>
        <%= f.text_field :last_name, class: "w-full border rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :skill_level, "Skill Level *", class: "block font-medium mb-1" %>
        <%= f.text_field :skill_level, class: "w-full border rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :bio, class: "block font-medium mb-1" %>
        <%= f.text_area :bio, rows: 4, class: "w-full border rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :skill_ids, "Skills *", class: "block font-medium mb-1" %>
        <%= f.collection_select(
              :skill_ids,
              @skills,
              :id,
              :name,
              { prompt: "Select skills" },
              { multiple: true, class: "w-full border rounded-lg px-3 py-2" }
            ) %>
        <p class="mt-1 text-sm text-gray-400">
          Please select at least one skill. <br>
          Hold <span class="font-medium">Ctrl</span> (Windows) or
          <span class="font-medium">Command ⌘</span> (Mac) to select multiple.
        </p>
      </div>

      <div class="pt-4 text-center">
        <%= f.submit "Save Profile",
                     class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

    <% end %>
  </div>
</div>


