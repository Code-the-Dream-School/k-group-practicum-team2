<% text_class ||= "text-gray-600 mb-2 ml-2" %>

<% case project.status %>
  <% when 'mentors' %>
    <p class="<%= text_class %>">Looking for mentors.</p>
  <% when 'teammates' %>
    <p class="<%= text_class %>">Looking for teammates.</p>
  <% when 'both' %>
    <p class="<%= text_class %>">Looking for mentors.</p>
    <p class="<%= text_class %>">Looking for teammates.</p>
  <% when 'closed' %>
    <p class="<%= text_class %>">Project closed.</p>
<% end %>
