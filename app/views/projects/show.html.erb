<div class="min-h-screen bg-gray-100 py-10">
  <div class="flex flex-col max-w-3xl mx-auto bg-white shadow-lg rounded-2xl p-8 gap-6">
    <div>
      <h1 class="text-3xl font-bold text-center text-gray-500 mb-4"><%= @project.title %></h1>
      <% if @project.project_skills.any? %>
        <p class="mb-2">Technologies & Skills</p>
        <ul class="flex flex-wrap gap-2 ml-2 text-gray-600 mb-2">
          <%= render 'project_skills', project: @project, item_class:"bg-gray-100 py-1 px-2 rounded-lg" %>
        </ul>
      <% end %>

      <p>Project Description</p>
      <p class="text-gray-600 mb-2 ml-2"><%= @project.description %></p>
      <% if @project&.url.present? %>
        <%= link_to "Project Repo ", @project.url, target: :_blank, rel: :noopener %>
      <% end %>
      <p>Project Status</p>
      <%= render 'project_status', project: @project, text_class:"text-gray-600 mb-2 ml-2" %>
    </div>

    <div class="flex justify-center gap-8">
      <% if @project.user == current_user %>
        <%= link_to "Edit Project", edit_project_path(@project), class: "bg-blue-50 text-blue-700 px-4 py-2 rounded-lg hover:bg-white hover:border hover:text-blue-800 transition" %>
        <%= button_to 'Delete Project', project_path(@project), method: :delete, class: "bg-blue-50 text-red-600 px-4 py-2 rounded-lg hover:bg-white hover:border hover:text-red-800 transition" %>
      <% else %>
        <% bookmark = current_user.bookmarked_projects.find_by(project: @project) %>
        <% if bookmark %>
          <div class="flex items-center gap-2">
            <img src="<%= asset_path('star-filled.svg') %>" alt='bookmark star' width='20' height='20' >
            <%= button_to "Remove Bookmark", project_bookmarked_project_path(@project, bookmark), method: :delete,
            class: 'bg-black text-white px-4 py-2 rounded-lg hover:opacity-80 transition' %>
          </div>
        <% else %>
          <div class="flex items-center gap-2" >
            <img src="<%= asset_path('star-empty.svg') %>" alt='empty star' width='20' height='20' >
            <%= button_to "Bookmark Project", project_bookmarked_projects_path(@project), method: :post,
              class: 'bg-black text-white px-4 py-2 rounded-lg hover:opacity-80 transition' %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>