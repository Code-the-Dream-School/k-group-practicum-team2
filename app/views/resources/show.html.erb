<div class="min-h-screen bg-gray-100 py-10">
  <div class="flex flex-col max-w-3xl mx-auto bg-white shadow-lg rounded-2xl p-8 gap-6">
    <h1 class="text-3xl font-bold text-center text-gray-500"><%= @resource.title %></h1>
    <p class="text-gray-600 text-center mb-2"><%= @resource.description %></p>
    <p class="text-gray-600 mt-2">
      Link to resource:
      <%= link_to @resource.url, @resource.url, target: "_blank", rel: 'noopener', class: "mt-3 text-blue-500 hover:underline" %>
    </p>

    <div class="flex justify-center gap-8">
      <% if @resource.user == current_user %>
        <%= link_to "Edit Resource", edit_resource_path(@resource), class: "bg-blue-50 text-blue-700 px-4 py-2 rounded-lg hover:bg-white hover:border hover:text-blue-800 transition"%>
        <%= button_to 'Delete Resource', resource_path(@resource), method: :delete, class: "bg-blue-50 text-red-600 px-4 py-2 rounded-lg hover:bg-white hover:border hover:text-red-800 transition"%>
      <% else %>
        <% bookmark = current_user.bookmarked_resources.find_by(resource: @resource) %>
        <% if bookmark %>
          <div class="flex items-center gap-2" >
            <img src="<%= asset_path('star-filled.svg') %>" alt='bookmark star' width='20' height='20' >
            <%= button_to "Remove Bookmark", resource_bookmarked_resource_path(@resource, bookmark), method: :delete,
            class: 'bg-black text-white px-4 py-2 rounded-lg hover:opacity-80 transition' %>
          </div>
        <% else %>
          <div class="flex items-center gap-2" >
            <img src="<%= asset_path('star-empty.svg') %>" alt='empty star' width='20' height='20' >
            <%= button_to "Bookmark Resource", resource_bookmarked_resources_path(@resource), method: :post,
              class: 'bg-black text-white px-4 py-2 rounded-lg hover:opacity-80 transition' %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
